IPADDR=172.16.0.5
NETMASK=255.255.255.0
GATEWAY=172.16.0.1
DNS1=8.8.8.8
BOOTPROTO=static
ONBOOT=yes


////////////////////
sudo nmcli con mod enp1s0 ipv4.method manual ipv4.addresses 192.168.1.2/24
sudo nmcli con mod enp1s0 ipv4.gateway 192.168.1.1
